<Window
    x:Class="ReactorCompositionSpike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="透明合成验证 - Reactor UI over D3D SwapChain">

    <Grid>
        <!-- Bottom layer: live D3D11 swap chain (animated clear colour = stand-in 3D viewport) -->
        <controls:SwapChainPanel x:Name="ScPanel" />

        <!-- Top layer: transparent host; the Reactor UI is mounted here in code-behind -->
        <Border x:Name="OverlayHost" Background="Transparent" />

        <!-- Status / controls -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12"
                Padding="12,8" CornerRadius="6" Background="#A0000000">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock x:Name="FpsText" FontFamily="Consolas" Foreground="White"
                           VerticalAlignment="Center" Text="swapchain present FPS: --" />
                <Button x:Name="HeavyBtn" Content="重叠加: 关" Click="OnToggleHeavy" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
