<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Must match Reactor's TFM (net10.0-windows10.0.22621.0). -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <RootNamespace>ReactorPerfLab</RootNamespace>
    <AssemblyName>ReactorPerfLab</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- This project lives OUTSIDE the reactor repo, so it does NOT inherit the
         repo's Directory.Build.props. Both values below are normally supplied
         there; pin them explicitly here (same as TreeViewHeteroVerify). -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
  </ItemGroup>

  <!-- Reference the fork's Reactor source so we benchmark against the live fork
       (currently the #447 typed-tree fix). -->
  <ItemGroup>
    <ProjectReference Include="..\microsoft-ui-reactor\src\Reactor\Reactor.csproj" />
  </ItemGroup>

</Project>
