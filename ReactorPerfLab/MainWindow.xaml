<Window
    x:Class="ReactorPerfLab.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:ReactorPerfLab.Model"
    xmlns:sel="using:ReactorPerfLab.Xaml"
    Title="Reactor Perf Lab">

    <Grid x:Name="RootGrid" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <!-- ── TreeView scenario: single homogeneous template (no selector → no crash) ── -->
            <DataTemplate x:Key="NodeTemplate" x:DataType="model:Node">
                <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="{x:Bind Glyph}" Foreground="{x:Bind AccentBrush}" />
                        <StackPanel>
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Detail}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Background="{x:Bind AccentBrush}" CornerRadius="3"
                                Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind KindLabel}" FontSize="10" Foreground="White" />
                        </Border>
                    </StackPanel>
                </TreeViewItem>
            </DataTemplate>

            <!-- ── Fragment-level templates (Text / Button / Checkbox), chosen by FragmentSelector ── -->
            <DataTemplate x:Key="TextFragmentTemplate" x:DataType="model:Fragment">
                <Border Background="{x:Bind ChipBackground}" CornerRadius="3"
                        Padding="{x:Bind ChipPadding}" Margin="0,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Text}" Foreground="{x:Bind Foreground}"
                               FontWeight="{x:Bind Weight}" FontSize="12" />
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="ButtonFragmentTemplate" x:DataType="model:Fragment">
                <Button Content="{x:Bind Text}" FontSize="11" Padding="6,0" MinWidth="0"
                        Margin="0,0,4,0" VerticalAlignment="Center" />
            </DataTemplate>
            <DataTemplate x:Key="CheckboxFragmentTemplate" x:DataType="model:Fragment">
                <CheckBox Content="{x:Bind Text}" MinWidth="0" Margin="0,0,4,0" VerticalAlignment="Center" />
            </DataTemplate>
            <sel:FragmentTemplateSelector x:Key="FragmentSelector"
                Text="{StaticResource TextFragmentTemplate}"
                Button="{StaticResource ButtonFragmentTemplate}"
                Checkbox="{StaticResource CheckboxFragmentTemplate}" />

            <!-- ── Heterogeneous ROW templates, chosen per-item by the two-arg StmtSelector ── -->
            <DataTemplate x:Key="StmtControlTemplate" x:DataType="model:StatementRow">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="{x:Bind Indent}">
                    <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="#808080" VerticalAlignment="Center" />
                    <Border Width="4" CornerRadius="2" Background="{x:Bind KindBrush}" />
                    <Border Background="{x:Bind KindBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind KindLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind Fragments}" ItemTemplateSelector="{StaticResource FragmentSelector}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Content="+" FontSize="11" Padding="6,0" MinWidth="0" Opacity="0.5" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="StmtCallTemplate" x:DataType="model:StatementRow">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="{x:Bind Indent}">
                    <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="#808080" VerticalAlignment="Center" />
                    <Border Background="{x:Bind KindBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind KindLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind Fragments}" ItemTemplateSelector="{StaticResource FragmentSelector}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Content="+" FontSize="11" Padding="6,0" MinWidth="0" Opacity="0.5" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="StmtCommentTemplate" x:DataType="model:StatementRow">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="{x:Bind Indent}" Opacity="0.65">
                    <TextBlock Text="//" Foreground="#6A9955" FontSize="12" FontStyle="Italic" VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{x:Bind Fragments}" ItemTemplateSelector="{StaticResource FragmentSelector}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>

            <sel:StatementRowTemplateSelector x:Key="StmtSelector"
                Control="{StaticResource StmtControlTemplate}"
                Call="{StaticResource StmtCallTemplate}"
                Comment="{StaticResource StmtCommentTemplate}" />

            <!-- Lightweight mode: empty placeholder; code-behind fills each realized container with a
                 single RichTextBlock (colored Runs) in ContainerContentChanging. -->
            <DataTemplate x:Key="LightRowTemplate" x:DataType="model:StatementRow">
                <Border />
            </DataTemplate>
        </Grid.Resources>

        <!-- Row 0: title -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Reactor Perf Lab - 复杂模板列表/树 性能对比" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="语句行场景建模 SCE 触发器编辑器：每行=变长异构片段（表达式树展开，含按钮/复选框等真实控件）。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Row 1: controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="场景" VerticalAlignment="Center" />
                <ComboBox x:Name="ScenarioCombo" Width="210" SelectedIndex="0" SelectionChanged="OnScenarioChanged">
                    <ComboBoxItem Content="ListView 语句行 (异构)" Tag="List" />
                    <ComboBoxItem Content="TreeView (同构基线)" Tag="Tree" />
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="框架" VerticalAlignment="Center" />
                <ComboBox x:Name="FrameworkCombo" Width="150" SelectedIndex="0" SelectionChanged="OnFrameworkChanged">
                    <ComboBoxItem Content="WinUI XAML" Tag="Xaml" />
                    <ComboBoxItem Content="Reactor" Tag="Reactor" />
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="渲染" VerticalAlignment="Center" />
                <ComboBox x:Name="RenderModeCombo" Width="180" SelectedIndex="0" SelectionChanged="OnRenderModeChanged">
                    <ComboBoxItem Content="多元素 (重)" Tag="Heavy" />
                    <ComboBoxItem Content="RichText 轻量" Tag="Light" />
                    <ComboBoxItem Content="可交互 (XamlHost)" Tag="Interactive" />
                    <ComboBoxItem Content="可交互 (声明式)" Tag="InteractiveDecl" />
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="Lbl1" Text="行数" VerticalAlignment="Center" />
                <NumberBox x:Name="RootsBox" Width="100" Value="500" Minimum="1" Maximum="50000"
                           SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="Lbl2" Text="片段/行" VerticalAlignment="Center" />
                <NumberBox x:Name="ChildrenBox" Width="96" Value="14" Minimum="1" Maximum="120"
                           SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="Lbl3" Text="最大缩进" VerticalAlignment="Center" />
                <NumberBox x:Name="DepthBox" Width="84" Value="4" Minimum="0" Maximum="12"
                           SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <Button x:Name="GenerateBtn" Content="生成 / 重建" Click="OnGenerate" Style="{ThemeResource AccentButtonStyle}" />
            <Button x:Name="ScrollBtn" Content="跳变压测" Click="OnAutoScroll" />
            <Button x:Name="BlankBtn" Content="空白恢复" Click="OnBlankRecovery" />
            <Button x:Name="SweepBtn" Content="片段扫描" Click="OnSweep" />
            <Button x:Name="ExpandBtn" Content="展开全部" Click="OnExpandAll" />
            <Button x:Name="CollapseBtn" Content="折叠全部" Click="OnCollapseAll" />
            <Button Content="测内存" Click="OnMeasureMemory" />
        </StackPanel>

        <!-- Row 2: metrics -->
        <Border Grid.Row="2" Padding="12,8" CornerRadius="6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="2">
                <TextBlock x:Name="FpsText" FontFamily="Consolas" Text="FPS  --" />
                <TextBlock x:Name="MetricsText" FontFamily="Consolas" Text="--" />
                <TextBlock x:Name="MemoryText" FontFamily="Consolas" Text="内存: 点 “测内存” 触发 GC 后采样" />
                <TextBlock x:Name="ResultText" FontFamily="Consolas" Foreground="{ThemeResource SystemAccentColorLight2}" Text="压测结果: 点 “自动滚动” 或 “片段扫描”" />
            </StackPanel>
        </Border>

        <!-- Row 3: host (filled from code-behind) -->
        <Border Grid.Row="3" x:Name="HostContainer" CornerRadius="6"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
    </Grid>
</Window>
