<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Must match Reactor's TFM (net10.0-windows10.0.22621.0). -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- This project lives OUTSIDE the reactor repo, so it does NOT inherit the
         repo's Directory.Build.props. Both values below are normally supplied
         there; we pin them explicitly here. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
  </ItemGroup>

  <!-- ProjectReference into the FORK's source. Because the fork is currently
       checked out on branch fix/447-treeview-typed-tree, we are compiling and
       running against the #447 fix. Switch the fork back to main and this same
       reference would build against the unfixed code. -->
  <ItemGroup>
    <ProjectReference Include="..\microsoft-ui-reactor\src\Reactor\Reactor.csproj" />
  </ItemGroup>

</Project>
