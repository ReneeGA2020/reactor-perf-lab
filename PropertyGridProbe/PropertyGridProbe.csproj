<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Must match Reactor's TFM (net10.0-windows10.0.22621.0). -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- This project lives OUTSIDE the reactor repo, so it does NOT inherit the
         repo's Directory.Build.props. Pin the self-contained flag explicitly. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
  </ItemGroup>

  <!-- Compile/run against the fork's source (currently on branch perf-lab). -->
  <ItemGroup>
    <ProjectReference Include="..\microsoft-ui-reactor\src\Reactor\Reactor.csproj" />
  </ItemGroup>

</Project>
